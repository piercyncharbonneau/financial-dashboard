# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Auth (NextAuth v5 + Google) ---
# Generate with: npx auth secret
AUTH_SECRET=
# From a Google Cloud OAuth client (console.cloud.google.com > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Anyone signing in with this email domain is let in. Leave blank to rely on ALLOWED_EMAILS only.
ALLOWED_EMAIL_DOMAIN=hoodz.us.com
# Comma-separated list of additional individual emails to allow (e.g. an advisor outside the domain).
ALLOWED_EMAILS=

# --- QuickBooks Online (developer.intuit.com) ---
# Your Intuit app has separate Development (sandbox) and Production credentials.
# Development keys only connect to a fake test company — use Production keys
# here to pull your real HOODZ data.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/api/integrations/quickbooks/callback
QBO_ENVIRONMENT=sandbox

# --- Storage for QuickBooks tokens + cached reports (production) ---
# Add "Upstash for Redis" from the Vercel Storage tab — it sets these two
# automatically. Without them, tokens don't survive between serverless
# invocations in production (a local file is used in dev instead).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Daily auto-refresh (Vercel Cron, see vercel.json) ---
# Any random string. Vercel sends it automatically as a bearer token when
# it triggers the cron job; without it set, the cron endpoint is unauthenticated.
CRON_SECRET=
